# Copy to .env and fill in. Never commit .env.
# Every value below is a local-development placeholder.

# Which environment this is: local | test | staging | production.
# Development OTP senders and the seed only run under local or test.
APP_ENV=local
NODE_ENV=development

# --- Postgres ---------------------------------------------------------------
# Admin connection used only by `pnpm db:bootstrap` to create the two roles.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/careloop
# Passwords for the roles db:bootstrap creates.
DATABASE_OWNER_PASSWORD=change-me-owner
DATABASE_APP_PASSWORD=change-me-app
# Migrations run as the owner role.
DATABASE_OWNER_URL=postgresql://careloop_owner:change-me-owner@localhost:5432/careloop
# The application connects as the non-owner app role, which row-level security applies to.
DATABASE_URL=postgresql://careloop_app:change-me-app@localhost:5432/careloop

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-32-byte-random-secret
JWT_ISSUER=careloop-api
JWT_AUDIENCE=careloop-web
OTP_PEPPER=replace-with-a-32-byte-random-secret
PHONE_HASH_PEPPER=replace-with-a-32-byte-random-secret

# --- Operator commands ------------------------------------------------------
# Fixed UUID identifying the CareLoop staff member running ops:* commands.
OPERATOR_ID=00000000-0000-4000-8000-000000000001

# --- Web and API ------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
API_PORT=4000
